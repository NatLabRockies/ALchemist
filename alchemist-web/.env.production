# Production environment variables

# API Base URL. The built app is served by the API itself (api/main.py mounts
# dist/), so a same-origin path works on any host and port (8000, a second
# instance on 8010, Docker port mappings, a remote lab box). An absolute
# http://localhost:8000 URL sent every request to port 8000 on the viewer's
# own machine whatever server had served the page.
VITE_API_BASE_URL=/api/v1

VITE_API_TIMEOUT=30000
